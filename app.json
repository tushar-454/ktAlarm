{
  "expo": {
    "name": "ktAlerm",
    "slug": "ktAlerm",
    "owner": "tusharimran.olw",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#0E1116",
    "scheme": "ktalerm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.imtushar454.ktAlerm",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "ktAlerm schedules alarms that ring at the time you choose, even when the app is closed.",
        "NSCameraUsageDescription": "ktAlerm uses the camera to register barcodes and complete barcode and squat wake-up missions.",
        "NSMotionUsageDescription": "ktAlerm counts your steps to complete walking wake-up missions.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1116",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.imtushar454.ktAlerm"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "./plugins/with-kt-alarm-ios",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1116",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0E1116",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9ea747a5-2da3-457d-a036-915e78be149a"
      }
    }
  }
}
